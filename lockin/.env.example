# --- Solana ---
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# devnet | testnet | mainnet-beta (explorer links)
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Escrow/treasury wallet that receives 0.05 SOL stakes (base58 public key)
NEXT_PUBLIC_TREASURY_ADDRESS=

# --- Database ---
DATABASE_URL=postgres://lockin:lockin@localhost:5432/lockin

# --- Helius webhook ---
# Set the same value as the "Auth Header" when creating the webhook in the Helius dashboard.
HELIUS_WEBHOOK_SECRET=

# --- Cloudflare Stream (proof video uploads) ---
CF_ACCOUNT_ID=
CF_STREAM_API_TOKEN=

# --- Cron jobs ---
# Sent as "Authorization: Bearer <CRON_SECRET>". At least 16 chars, e.g. `openssl rand -hex 32`.
CRON_SECRET=
# Receives the 10% platform fee; also the fee payer for payout transactions.
PLATFORM_TREASURY_ADDRESS=

# --- Payout executor (scripts/execute-payouts.mts; operator machine only, never the web server) ---
# Solana CLI keypair JSON files. ESCROW must match NEXT_PUBLIC_TREASURY_ADDRESS,
# PLATFORM must match PLATFORM_TREASURY_ADDRESS. chmod 600 both.
ESCROW_KEYPAIR_PATH=
PLATFORM_KEYPAIR_PATH=
