{
  "name": "@arena/stream-overlay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5174 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.capture.json",
    "capture:record": "tsx capture/record.ts",
    "capture:kiosk": "tsx capture/kiosk.ts",
    "stream": "bash scripts/stream_to_youtube.sh"
  },
  "dependencies": {
    "@arena/shared": "workspace:*",
    "lightweight-charts": "5.2.1",
    "qrcode.react": "4.2.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "socket.io-client": "4.8.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "puppeteer": "24.43.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "6.4.3"
  }
}
