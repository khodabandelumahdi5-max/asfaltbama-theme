{
  "name": "trade-arena",
  "private": true,
  "version": "1.0.0",
  "description": "Skill-based fast paper trading tournament platform: Telegram Mini App, realtime server, bot and 24/7 live stream overlay.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" run dev",
    "dev:server": "pnpm --filter @arena/server dev",
    "dev:bot": "pnpm --filter @arena/bot dev",
    "dev:webapp": "pnpm --filter @arena/webapp dev",
    "dev:overlay": "pnpm --filter @arena/stream-overlay dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "db:migrate": "pnpm --filter @arena/server db:migrate",
    "redis:up": "docker compose up -d redis",
    "redis:down": "docker compose down",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:e2e": "pnpm --filter @arena/server test:e2e",
    "sim:traders": "pnpm --filter @arena/server sim:traders"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "puppeteer": "24.43.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "puppeteer"
    ]
  }
}
