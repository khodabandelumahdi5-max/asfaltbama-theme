# ---------- shared ----------
NODE_ENV=development
REDIS_URL=redis://127.0.0.1:6379

# Bot token from @BotFather. Server uses it to validate Telegram WebApp initData.
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_BOT_USERNAME=TradeArenaBot
# Short name of the Mini App registered via BotFather /newapp (used for t.me/<bot>/<app>?startapp=... links)
TELEGRAM_WEBAPP_SHORT_NAME=arena

# Shared secret between bot <-> server internal API
INTERNAL_API_KEY=change-me-internal-key-at-least-32-characters

# ---------- server ----------
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
DATABASE_PATH=./data/arena.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5174
ALLOW_DEV_AUTH=true
DEPOSIT_WEBHOOK_SECRET=change-me-webhook-secret-at-least-32-chars
DEPOSIT_ADDRESS_TRC20=TQn9Y2khEsLJW1ChVWFMSMeRDow5KcbLSE
DEPOSIT_ADDRESS_TON=UQBvW8Z5huBkMJYdnfAEM5JqTNkuWX3diqYENkWsIL0XggGG
TICKET_PRICE_USDT=1
TOURNAMENT_DURATION_SEC=600
TOURNAMENT_BREAK_SEC=30
TOURNAMENT_ENTRY_TICKETS=1
STARTING_BALANCE=10000
PRICE_SEED=65000
PRICE_TICK_MS=250
CANDLE_INTERVAL_SEC=5

# ---------- bot ----------
SERVER_INTERNAL_URL=http://127.0.0.1:4000
# Must be HTTPS for Telegram (use cloudflared/ngrok tunnel in dev)
WEBAPP_URL=https://your-tunnel.trycloudflare.com
BOT_MODE=polling
BOT_WEBHOOK_DOMAIN=
BOT_WEBHOOK_PORT=4100
BOT_WEBHOOK_SECRET=

# ---------- webapp (Next.js) ----------
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
NEXT_PUBLIC_BOT_USERNAME=TradeArenaBot

# ---------- stream overlay ----------
VITE_SERVER_URL=http://localhost:4000
VITE_JOIN_URL=https://t.me/TradeArenaBot/arena

# ---------- 24/7 streaming (apps/stream-overlay/scripts/stream_to_youtube.sh) ----------
YOUTUBE_STREAM_KEY=
YOUTUBE_RTMP_URL=rtmp://a.rtmp.youtube.com/live2
LAYOUT=landscape
FPS=60
VIDEO_BITRATE=9000k
VIDEO_ENCODER=libx264
OVERLAY_URL=http://localhost:5174
# Optional: path to a Chrome/Chromium binary for Puppeteer (defaults to Puppeteer's bundled Chrome)
CHROME_PATH=
